PORT=8080

# Clave que usa TU backend para encolar mensajes. Generala con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=

# Token del telefono-pasarela. Distinto de API_KEY: si pierdes el telefono
# revocas solo este.
DEVICE_TOKEN=

DATABASE_PATH=./data/sms-bridge.db
DEVICE_BATCH_SIZE=10
MAX_ATTEMPTS=3
